# Required runtime credentials
PINECONE_API_KEY=
GROQ_API_KEY=

# Database
# Use PostgreSQL in production. If omitted, the backend falls back to SQLite in
# instance/medicore.sqlite3 for local development only.
DATABASE_URL=
# DATABASE_URL=postgresql+psycopg://medicore:change-me@localhost:5432/medicore
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=10
DATABASE_POOL_TIMEOUT=30
DATABASE_POOL_RECYCLE=1800
DATABASE_AUTO_CREATE=0

# Supabase auth verification for backend user/session persistence.
# SUPABASE_JWT_SECRET is recommended for production local JWT verification.
# If omitted, the backend validates bearer tokens against Supabase Auth /user.
# Never expose the JWT secret to the browser.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_JWT_SECRET=
SUPABASE_JWT_AUDIENCE=authenticated
SUPABASE_JWT_ALGORITHMS=HS256
FRONTEND_URL=http://127.0.0.1:8080
CORS_ALLOWED_ORIGINS=http://127.0.0.1:8080,http://localhost:8080
AUTH_REDIRECT_ALLOWED_ORIGINS=http://127.0.0.1:8080,http://localhost:8080

# Pinecone
PINECONE_INDEX_NAME=medical-chatbot
PINECONE_CLOUD=aws
PINECONE_REGION=us-east-1

# Retrieval and model settings
RETRIEVER_K=3
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_TEMPERATURE=0.2
GROQ_MAX_TOKENS=1024

# Flask/Gunicorn
FLASK_DEBUG=0
FLASK_RUN_HOST=0.0.0.0
PORT=1819
WEB_CONCURRENCY=1
GUNICORN_TIMEOUT=120
LOG_LEVEL=INFO

# Indexing script
PDF_DATA_DIR=data
